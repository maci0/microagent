extends: default

rules:
  # Workflow steps are long shell blocks; a comment column at 80 would wrap
  # every explanation line in them. A cap is still worth having, so a pasted
  # block or a generated matrix cannot grow a line no reviewer can read.
  #
  # Two files reach 148 and nothing passes it: the release.yml step that reports
  # what the published release carried, and the setup-zig cache key, which spells
  # out the same expressions the action's comment above it explains. 160 leaves
  # both alone with 12 columns to spare.
  line-length:
    max: 160
  document-start: disable
  # `on:` is the GitHub Actions key, not a boolean.
  truthy:
    check-keys: false
  comments:
    min-spaces-from-content: 1
