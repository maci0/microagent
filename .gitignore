zig-out/
.zig-cache/
zig-pkg/
dist/
# The release note release.yml builds out of the checked-out tree, so a run
# that is cut short between writing it and publishing it leaves a file a
# `git status` offers to commit.
release-notes.md
__pycache__/
.scratch/
# The Harbor adapter's musl binary, one name per host architecture. It is a
# build product of `make musl`, ~1.3 MB, and nothing in the repo reads it.
integrations/harbor/microagent-*-linux-musl
integrations/harbor/microagent-*-linux-musl.tmp
# A style config written here to try a level out. The template that is tracked
# is config.example.toml; a key in this one must never reach a commit.
config.toml
.env
